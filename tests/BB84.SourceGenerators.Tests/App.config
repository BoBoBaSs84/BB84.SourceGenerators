<?xml version="1.0" encoding="utf-8"?>
<configuration>
	<runtime>
		<assemblyBinding xmlns="urn:schemas-microsoft-com:asm.v1">
			<!-- Lets Assembly.Load("System.Runtime") / Assembly.Load("netstandard") resolve the GAC facades on .NET Framework (Microsoft.Testing.Platform has no testhost resolver). -->
			<qualifyAssembly partialName="System.Runtime" fullName="System.Runtime, Version=4.0.0.0, Culture=neutral, PublicKeyToken=b03f5f7f11d50a3a" />
			<qualifyAssembly partialName="netstandard" fullName="netstandard, Version=2.0.0.0, Culture=neutral, PublicKeyToken=cc7b13ffcd2ddd51" />
		</assemblyBinding>
	</runtime>
</configuration>
